{
  "name": "kera-spare-tracker-backend",
  "version": "1.0.0",
  "description": "Production Node.js, Express & MySQL backend for Kera Spare Tracker",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "node prisma/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "cleanup-tokens": "node scripts/cleanup-tokens.js",
    "dev:cleanup-test-data": "node scripts/dev-cleanup-test-data.js",
    "test": "vitest run --passWithNoTests"
  },

  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "express",
    "prisma",
    "mysql",
    "kera-spare-tracker",
    "multi-tenant"
  ],
  "author": "Kera Spare Tracker Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.3",
    "winston": "^3.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.4"
  }
}
