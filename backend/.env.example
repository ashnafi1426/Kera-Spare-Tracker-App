# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=7000
NODE_ENV=development

# ==========================================
# DATABASE CONNECTION (MySQL 8)
# If using Laragon/XAMPP with default root (no password):
# DATABASE_URL="mysql://root:@localhost:3306/kera_spare_tracker?connection_limit=10"
# If MySQL has a root password:
# DATABASE_URL="mysql://root:YourPassword@localhost:3306/kera_spare_tracker?connection_limit=10"
# ==========================================
DATABASE_URL="mysql://root:@localhost:3306/kera_spare_tracker"

# ==========================================
# AUTHENTICATION & JWT SECRETS
# Generate strong 64-char strings in production
# ==========================================
JWT_SECRET="kera-spare-tracker-jwt-secret-key-super-secure-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# ==========================================
# CORS CONFIGURATION
# Comma-separated list of allowed origins
# ==========================================
CORS_ORIGIN="http://localhost:3000,http://localhost:7000,http://127.0.0.1:3000,*"

# ==========================================
# DEFAULT ADMIN CREDENTIALS (USED BY SEED SCRIPT)
# ==========================================
ADMIN_PHONE="+251900000000"
ADMIN_PASSWORD="AdminPassword123!"
ADMIN_BUSINESS_NAME="Kera System Admin"

# ==========================================
# STORAGE CONFIGURATION
# Local storage directory for private uploads
# ==========================================
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5
