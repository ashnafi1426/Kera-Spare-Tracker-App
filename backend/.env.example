PORT=7000
NODE_ENV=development

# MySQL Database
DATABASE_URL="mysql://root:@localhost:3306/mobile"

# JWT Secrets & Expiration
JWT_SECRET="kera-spare-tracker-jwt-access-secret-2026-super-secure"
