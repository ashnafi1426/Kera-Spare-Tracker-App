datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================
enum UserRole {
  OWNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum UserLanguage {
  AMHARIC
  ENGLISH
}

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT
}

enum SubscriptionTier {
  FREE
  STANDARD
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  TRIAL
}

// ==========================================
// MODELS
// ==========================================

model User {
  id                 String       @id @db.Char(36)
  phoneNumber        String       @unique @db.VarChar(20)
  businessName       String       @db.VarChar(100)
  passwordHash       String       @db.VarChar(255)
  role               UserRole     @default(OWNER)
  status             UserStatus   @default(ACTIVE)
  language           UserLanguage @default(AMHARIC)
  lastLoginAt        DateTime?    @db.Timestamp(6)
  lastSyncAt         DateTime?    @db.Timestamp(6)
  failedSyncCount    Int          @default(0)
  appVersion         String?      @db.VarChar(50)
  mustChangePassword Boolean      @default(false)
  disabledAt         DateTime?    @db.Timestamp(6)
  suspendedReason    String?      @db.Text
  suspendedAt        DateTime?    @db.Timestamp(6)
  createdAt          DateTime     @default(now()) @db.Timestamp(6)
  updatedAt          DateTime     @updatedAt @db.Timestamp(6)
  deletedAt          DateTime?    @db.Timestamp(6)

  // Relations
  brands             Brand[]
  categories         Category[]
  units              Unit[]
  locations          Location[]
  spareParts         SparePart[]
  stockMovements     StockMovement[]
  sales              Sale[]
  saleItems          SaleItem[]
  subscriptions      Subscription[]
  refreshTokens      RefreshToken[]
  auditLogsCreated   AuditLog[]   @relation("AdminAuditLogs")
  auditLogsReceived  AuditLog[]   @relation("TargetUserAuditLogs")
  appSettingsUpdated AppSetting[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @db.Char(36)
  userId    String    @db.Char(36)
  tokenHash String    @db.VarChar(255)
  expiresAt DateTime  @db.Timestamp(6)
  revokedAt DateTime? @db.Timestamp(6)
  createdAt DateTime  @default(now()) @db.Timestamp(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Brand {
  id        String    @id @db.Char(36)
  ownerId   String?   @db.Char(36)
  name      String    @db.VarChar(100)
  isGlobal  Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @db.Timestamp(6)
  deletedAt DateTime? @db.Timestamp(6)

  // Relations
  owner      User?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  spareParts SparePart[]

  @@index([ownerId, updatedAt])
  @@map("brands")
}

model Category {
  id        String    @id @db.Char(36)
  ownerId   String?   @db.Char(36)
  name      String    @db.VarChar(100)
  isGlobal  Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @db.Timestamp(6)
  deletedAt DateTime? @db.Timestamp(6)

  // Relations
  owner      User?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  spareParts SparePart[]

  @@index([ownerId, updatedAt])
  @@map("categories")
}

model Unit {
  id        String    @id @db.Char(36)
  ownerId   String?   @db.Char(36)
  name      String    @db.VarChar(50)
  isGlobal  Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @db.Timestamp(6)
  deletedAt DateTime? @db.Timestamp(6)

  // Relations
  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt])
  @@map("units")
}

model Location {
  id        String    @id @db.Char(36)
  ownerId   String    @db.Char(36)
  name      String    @db.VarChar(100)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @db.Timestamp(6)
  deletedAt DateTime? @db.Timestamp(6)

  // Relations
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  spareParts SparePart[]

  @@index([ownerId, updatedAt])
  @@map("locations")
}

model SparePart {
  id             String    @id @db.Char(36)
  ownerId        String    @db.Char(36)
  name           String    @db.VarChar(200)
  partNumber     String?   @db.VarChar(100)
  photoUrl       String?   @db.VarChar(500)
  brandId        String?   @db.Char(36)
  categoryId     String?   @db.Char(36)
  locationId     String?   @db.Char(36)
  customLocation String?   @db.VarChar(100)
  description    String?   @db.Text
  unit           String?   @db.VarChar(50)
  cachedQuantity Decimal   @default(0.000) @db.Decimal(12, 3)
  purchasePrice  Decimal?  @db.Decimal(12, 2)
  sellingPrice   Decimal?  @db.Decimal(12, 2)
  notes          String?   @db.Text
  sizeSpecs      String?   @db.VarChar(100)
  createdAt      DateTime  @default(now()) @db.Timestamp(6)
  updatedAt      DateTime  @updatedAt @db.Timestamp(6)
  deletedAt      DateTime? @db.Timestamp(6)

  // Relations
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  brand          Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location       Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, name])
  @@index([ownerId, partNumber])
  @@map("spare_parts")
}

model StockMovement {
  id           String       @id @db.Char(36)
  ownerId      String       @db.Char(36)
  partId       String       @db.Char(36)
  movementType MovementType
  quantity     Decimal      @db.Decimal(12, 3)
  unitCost     Decimal?     @db.Decimal(12, 2)
  reason       String?      @db.VarChar(255)
  referenceId  String?      @db.VarChar(100)
  createdAt    DateTime     @default(now()) @db.Timestamp(6)
  updatedAt    DateTime     @updatedAt @db.Timestamp(6)
  deletedAt    DateTime?    @db.Timestamp(6)

  // Relations
  owner User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  part  SparePart @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt])
  @@index([ownerId, partId])
  @@map("stock_movements")
}

model Sale {
  id            String        @id @db.Char(36)
  ownerId       String        @db.Char(36)
  receiptNumber String        @db.VarChar(50)
  totalAmount   Decimal       @db.Decimal(12, 2)
  totalProfit   Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  customerName  String?       @db.VarChar(100)
  customerPhone String?       @db.VarChar(20)
  notes         String?       @db.Text
  soldAt        DateTime      @db.Timestamp(6)
  createdAt     DateTime      @default(now()) @db.Timestamp(6)
  updatedAt     DateTime      @updatedAt @db.Timestamp(6)
  deletedAt     DateTime?     @db.Timestamp(6)

  // Relations
  owner User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items SaleItem[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, soldAt])
  @@map("sales")
}

model SaleItem {
  id                String    @id @db.Char(36)
  ownerId           String    @db.Char(36)
  saleId            String    @db.Char(36)
  partId            String?   @db.Char(36)
  partNameSnapshot  String    @db.VarChar(200)
  quantity          Decimal   @db.Decimal(12, 3)
  unitCostSnapshot  Decimal   @db.Decimal(12, 2)
  unitPriceSnapshot Decimal   @db.Decimal(12, 2)
  subtotal          Decimal   @db.Decimal(12, 2)
  profit            Decimal   @db.Decimal(12, 2)
  createdAt         DateTime  @default(now()) @db.Timestamp(6)
  updatedAt         DateTime  @updatedAt @db.Timestamp(6)
  deletedAt         DateTime? @db.Timestamp(6)

  // Relations
  owner User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sale  Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  part  SparePart? @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([ownerId, updatedAt])
  @@index([saleId])
  @@map("sale_items")
}

model SubscriptionPlan {
  id           String    @id @db.Char(36)
  name         String    @db.VarChar(100)
  price        Decimal   @db.Decimal(12, 2)
  durationDays Int
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamp(6)
  updatedAt    DateTime  @updatedAt @db.Timestamp(6)
  deletedAt    DateTime? @db.Timestamp(6)

  @@map("subscription_plans")
}

model Subscription {
  id        String             @id @db.Char(36)
  ownerId   String             @db.Char(36)
  plan      SubscriptionTier   @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @db.Timestamp(6)
  endDate   DateTime?          @db.Timestamp(6)
  createdAt DateTime           @default(now()) @db.Timestamp(6)
  updatedAt DateTime           @updatedAt @db.Timestamp(6)
  deletedAt DateTime?          @db.Timestamp(6)

  // Relations
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt])
  @@map("subscriptions")
}

model AuditLog {
  id           String    @id @db.Char(36)
  adminId      String?   @db.Char(36)
  targetUserId String?   @db.Char(36)
  action       String    @db.VarChar(100)
  oldValue     Json?
  newValue     Json?
  reason       String?   @db.Text
  ipAddress    String?   @db.VarChar(45)
  userAgent    String?   @db.VarChar(255)
  createdAt    DateTime  @default(now()) @db.Timestamp(6)

  // Relations
  admin      User? @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: SetNull)
  targetUser User? @relation("TargetUserAuditLogs", fields: [targetUserId], references: [id], onDelete: SetNull)


  @@index([targetUserId, createdAt])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model AppSetting {
  id        String   @id @db.Char(36)
  key       String   @unique @db.VarChar(100)
  value     Json
  updatedBy String?  @db.Char(36)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  // Relations
  updater User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("app_settings")
}
